{
  "version": 2,
  "functions": {
    "api/public/index.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "web/views/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/public/index.php"
    },
    {
      "src": "/manifest.json",
      "dest": "/web/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/web/sw.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/web/assets/$1"
    },
    {
      "src": "/views/(.*)",
      "dest": "/web/views/$1"
    },
    {
      "src": "/",
      "dest": "/web/views/login.php"
    },
    {
      "handle": "filesystem"
    }
  ]
}