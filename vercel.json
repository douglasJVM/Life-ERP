{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "web/**/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "web/assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "web/manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "web/sw.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/public/index.php"
    },
    {
      "src": "/manifest.json",
      "dest": "/web/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/web/sw.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/web/assets/$1"
    },
    {
      "src": "/views/(.*)",
      "dest": "/web/views/$1"
    },
    {
      "src": "/",
      "dest": "/web/views/login.php"
    }
  ]
}